# RAF Intelligence MySQL configuration
#
# Persistent settings for the host MySQL instance backing both the RAF
# database and the OpenEMR container.  These values were previously set at
# runtime via `SET GLOBAL ...` which reverts on restart — the memory note
# `feedback_mysql_binlog_growth` documents the resulting ~100 MB/min binlog
# growth and 30-day default retention that fills disk.
#
# Deployment:
#   - Container: mount this file at /etc/mysql/conf.d/raf-intelligence.cnf
#   - Host MySQL: run `scripts/install-mysql-conf.sh` to copy this file in
#     place and restart the service.
#
# After applying, verify with:
#   SHOW VARIABLES LIKE 'binlog_expire_logs_seconds';   -- expect 86400
#   SHOW VARIABLES LIKE 'max_binlog_size';              -- expect 104857600
#   SHOW VARIABLES LIKE 'sync_binlog';                  -- expect 1
#   SHOW VARIABLES LIKE 'innodb_flush_log_at_trx_commit'; -- expect 1

[mysqld]
# Replication identity — primary uses server-id=1; replica must use server-id=2.
server-id = 1
log-bin = mysql-bin
binlog-format = ROW

binlog_expire_logs_seconds = 300
max_binlog_size = 100M
sync_binlog = 1
innodb_flush_log_at_trx_commit = 1
# PHI workload — durability over speed

# Sort + read buffers — pre_submission_validator scans 100K+ raf_patient_hcc
# rows with multi-column ORDER BY; the 256 KiB default overflows on disk
# with HY001 (Out of sort memory). 16 MiB is comfortable headroom.
sort_buffer_size = 16M
read_rnd_buffer_size = 4M

# Connection ceiling — beat + worker + backend + auto_sync polling can each
# hold 30+ pooled connections; default 151 is too tight.
max_connections = 500
