# RAF Intelligence System - Environment Configuration
# Copy to .env and fill in values

# Google Gemini
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-pro

# MySQL (used by docker-compose)
MYSQL_ROOT_PASSWORD=root

# OpenEMR Database
OPENEMR_DB_HOST=127.0.0.1
OPENEMR_DB_PORT=3309
OPENEMR_DB_USER=root
OPENEMR_DB_PASSWORD=root
OPENEMR_DB_NAME=openemr

# OpenEMR API
OPENEMR_URL=http://localhost:8080

# RAF Database
RAF_DB_HOST=127.0.0.1
RAF_DB_PORT=3309
RAF_DB_USER=root
RAF_DB_PASSWORD=root
RAF_DB_NAME=raf_intelligence

# Application
APP_PORT=8500
DASHBOARD_PORT=3500
NODE_ENV=production

# Frontend (optional, for custom backend URL)
NEXT_PUBLIC_API_URL=http://localhost:8500
