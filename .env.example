# ===========================================================================
# RAF Intelligence — Environment Variables Template
# Copy this file to .env and fill in actual values.
# NEVER commit .env (with real secrets) to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# AI / Gemini
# ---------------------------------------------------------------------------

# REQUIRED — Google API key for Gemini (obtain from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your-google-api-key-here

# OPTIONAL — Gemini model used for NLP analysis
# Recommended: gemini-2.5-pro (production), gemini-1.5-flash (lower cost)
GEMINI_MODEL=gemini-2.5-pro

# ---------------------------------------------------------------------------
# EMR Integration (FHIR R4 — recommended for production)
# ---------------------------------------------------------------------------

# EMR connections are managed via the UI (Integrations page).
# Customers provide a FHIR R4 endpoint URL and OAuth2 credentials — no direct
# database access or IP addresses are required.

# Base URL of the OpenEMR FHIR R4 endpoint (used for API-based data access)
# OPENEMR_FHIR_URL=https://your-openemr.example.com/apis/fhir/R4

# SMART on FHIR / OAuth2 credentials
# OPENEMR_API_CLIENT_ID=
# OPENEMR_API_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# OpenEMR Direct DB (DEVELOPMENT ONLY — never use in production)
# ---------------------------------------------------------------------------
# These variables are only used for local development with a bundled OpenEMR
# instance. In production, all EMR data flows through FHIR R4 APIs.
# OPENEMR_DB_HOST=127.0.0.1
# OPENEMR_DB_PORT=3306
# OPENEMR_DB_USER=openemr_app
# OPENEMR_DB_PASSWORD=change-me-strong-password
# OPENEMR_DB_NAME=openemr

# ---------------------------------------------------------------------------
# RAF Intelligence Database
# ---------------------------------------------------------------------------

# REQUIRED — Hostname or IP of the MySQL server hosting the raf_intelligence schema
RAF_DB_HOST=127.0.0.1

# OPTIONAL — MySQL port for the RAF database
RAF_DB_PORT=3306

# REQUIRED — MySQL credentials for the RAF schema. Use a dedicated app account in production.
RAF_DB_USER=raf_app
RAF_DB_PASSWORD=change-me-strong-password

# REQUIRED — MySQL database (schema) name for RAF Intelligence data
RAF_DB_NAME=raf_intelligence

# ---------------------------------------------------------------------------
# Database TLS / SSL (strongly recommended in production)
# ---------------------------------------------------------------------------

# Set to true to require TLS for all database connections
DB_SSL_ENABLED=false

# Path to the CA certificate file used to verify the database server certificate.
# Required when DB_SSL_ENABLED=true.
# DB_SSL_CA=/path/to/ca.pem
# DB_SSL_CERT=/path/to/client-cert.pem
# DB_SSL_KEY=/path/to/client-key.pem

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Runtime environment: development | staging | production
# Controls secret validation strictness. MUST be "production" on live deployments.
APP_ENV=production

# Port the FastAPI backend listens on
APP_PORT=8500

# Port the frontend server listens on (used by docker-compose)
DASHBOARD_PORT=3000

# Node environment for the frontend build
NODE_ENV=production

# REQUIRED — Full public URL of the deployed frontend — used for CORS and password-reset email links.
# Example: https://app.raf-intelligence.com
FRONTEND_URL=https://your-frontend-domain.com

# Public URL of the backend API (used by the frontend to construct API calls)
NEXT_PUBLIC_API_URL=https://your-api-domain.com

# ---------------------------------------------------------------------------
# Authentication / JWT
# ---------------------------------------------------------------------------

# REQUIRED — Secret key for signing access tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-64-char-random-hex-string

# REQUIRED — Separate secret key for signing refresh tokens. Generate independently.
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-hex-string

# Access token lifetime in minutes (HIPAA recommendation: 15 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# Number of consecutive failed logins before the account is locked
MAX_FAILED_LOGINS=5

# How long (in minutes) an account stays locked after exceeding MAX_FAILED_LOGINS
LOCKOUT_DURATION_MINUTES=15

# Inactivity timeout in minutes before a session is considered expired
IDLE_TIMEOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Redis (Celery broker and result backend)
# ---------------------------------------------------------------------------

# Redis connection URL.
# Use redis://:password@host:port/db_number when Redis has auth enabled.
# REQUIRED — Redis authentication password
REDIS_PASSWORD=change-me-strong-redis-password

# Redis connection URL (password must match REDIS_PASSWORD above)
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ---------------------------------------------------------------------------
# Celery (production worker tuning)
# ---------------------------------------------------------------------------

# Number of concurrent Celery worker processes
CELERY_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Gunicorn (production WSGI server)
# ---------------------------------------------------------------------------

# Number of Gunicorn worker processes (rule of thumb: 2 * CPU cores + 1)
GUNICORN_WORKERS=4

# ---------------------------------------------------------------------------
# Docker Compose port bindings
# ---------------------------------------------------------------------------

BACKEND_PORT=8500
FRONTEND_PORT=3000

# Docker image tag for deployments
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Bind-mount volume paths (used by docker-compose.prod.yml)
# ---------------------------------------------------------------------------

UPLOADS_PATH=./data/uploads
LOGS_PATH=./data/logs
REDIS_DATA_PATH=./data/redis

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------

# Directory where generated CMS submission files are written.
# Must be a persistent, backed-up volume in production — never /tmp.
SUBMISSION_OUTPUT_DIR=/var/lib/raf_intelligence/submissions

# ---------------------------------------------------------------------------
# SMTP / Email notifications
# ---------------------------------------------------------------------------

# SMTP server hostname (e.g. smtp.sendgrid.net, email-smtp.us-east-1.amazonaws.com)
SMTP_HOST=smtp.your-provider.com

# SMTP port (587 for STARTTLS, 465 for SSL/TLS)
SMTP_PORT=587

# SMTP authentication credentials
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# From address for outbound notification emails
SMTP_FROM=noreply@your-domain.com

# Enable STARTTLS for SMTP connections
SMTP_TLS=true

# ---------------------------------------------------------------------------
# TLS enforcement
# ---------------------------------------------------------------------------

# Set to true when the application is behind a TLS-terminating load balancer.
# Used for the /api/compliance/status HIPAA check. Does not configure TLS itself.
TLS_ENABLED=true

# ---------------------------------------------------------------------------
# Error monitoring (Sentry — optional but recommended in production)
# ---------------------------------------------------------------------------

# Sentry DSN — leave blank to disable error tracking
SENTRY_DSN=https://your-key@sentry.io/your-project-id

# Sentry environment tag
SENTRY_ENV=production

# ---------------------------------------------------------------------------
# Data retention
# ---------------------------------------------------------------------------

# Enable the automated data retention / purge background job
DATA_RETENTION_ENABLED=true

# How often (in hours) the retention job runs
RETENTION_CHECK_INTERVAL_HOURS=24
